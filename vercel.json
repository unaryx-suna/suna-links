{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/place/:path*",
      "destination": "/api/place"
    },
    {
      "source": "/trip/:path*",
      "destination": "/trip.html"
    },
    {
      "source": "/i/:path*",
      "destination": "/api/itinerary"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
