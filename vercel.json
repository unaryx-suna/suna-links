{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/field",
      "destination": "/field.html"
    },
    {
      "source": "/lab",
      "destination": "/lab.html"
    },
    {
      "source": "/place/:path*",
      "destination": "/api/place"
    },
    {
      "source": "/trip/:path*",
      "destination": "/trip.html"
    },
    {
      "source": "/i/:path*",
      "destination": "/api/itinerary"
    },
    {
      "source": "/u/:path*",
      "destination": "/api/invite"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/city/:path*",
      "destination": "/city.html"
    },
    {
      "source": "/c/:path*",
      "destination": "/api/venue"
    },
    {
      "source": "/e/:path*",
      "destination": "/api/event"
    }
  ],
  "functions": {
    "api/itinerary.js": {
      "includeFiles": "public/i.html"
    }
  }
}
